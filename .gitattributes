# Detect text files without modifying binary content.
* text=auto

# Keep Unity source and metadata in normal Git with LF line endings.
*.cs text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.meta text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.inputactions text eol=lf
*.json text eol=lf
*.md text eol=lf

# Only selected binary source formats under Assets use LFS.
# Small PNG/JPEG files, reference PDFs and serialized .asset files stay in Git.
Assets/**/*.[fF][bB][xX] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[bB][lL][eE][nN][dD] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[pP][sS][dD] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[pP][sS][bB] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[wW][aA][vV] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[fF][lL][aA][cC] filter=lfs diff=lfs merge=lfs -text
Assets/**/*.[eE][xX][rR] filter=lfs diff=lfs merge=lfs -text
